# Public site URL used for sitemap, canonicals, and Open Graph
# Use HTTPS (required for AdSense / Search Console canonicals)
NEXT_PUBLIC_SITE_URL=https://nextfreeinvoicegenerator.com

# Optional Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense publisher client (defaults to ca-pub-9252917783014745 if unset)
# Site ownership uses the google-adsense-account meta tag + public/ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9252917783014745

# Keep false until real AdSense unit IDs are wired into <AdSlot adSlot="...">.
# Empty "Advertisement" placeholders are removed; the ads library loads only
# after cookie consent when this flag is true.
# NEXT_PUBLIC_SHOW_AD_SLOTS=false
